@model CampusExchangeWebApp.Models.LoanModel

@{
    ViewData["Title"] = "Borrow Request";
}

<h1>Accept Borrow Request</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="ProcessAccept">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" name="requestId" value="@ViewBag.RequestId" />
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="ProductName" />
            <input type="hidden" asp-for="BorrowerAccountId" />
            <input type="hidden" asp-for="BorrowerAccountName" />

            <div class="form-group mb-3">
                <label class="control-label">Product</label>
                <input value="@Model.ProductName" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Borrower</label>
                <input value="@Model.BorrowerAccountName" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="ExpectedReturnDate" class="control-label">Expected Return Date</label>
                <input asp-for="ExpectedReturnDate" class="form-control" type="date" />
                <span asp-validation-for="ExpectedReturnDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Confirm Acceptance" class="btn btn-success" />
                <a asp-action="MyRequests" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
