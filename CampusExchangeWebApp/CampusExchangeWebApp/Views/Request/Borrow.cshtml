@model CampusExchangeWebApp.Models.RequestModel

@{
    ViewData["Title"] = "Borrow Request";
}

<h1>Request to Borrow</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="ProcessBorrow">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="ProductId" />

            <div class="form-group mb-3">
                <label asp-for="ProductName" class="control-label"></label>
                <input asp-for="ProductName" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Confirm Request" class="btn btn-primary" />
                <a asp-controller="Browse" asp-action="Index" class="btn btn-secondary">Back to Browse</a>
            </div>
        </form>
    </div>
</div>

