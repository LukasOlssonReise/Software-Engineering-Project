@model IEnumerable<CampusExchangeWebApp.Models.RequestModel>

@{
    ViewData["Title"] = "My Request Page";
}

<h1>List of your requests</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProductName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(model => item.AccountName)
            </td>
            <td>
                <a asp-action="Accept" asp-route-id="@item.Id">Accept</a> |
                <a asp-action="Reject" asp-route-id="@item.Id">Reject</a>
            </td>
        </tr>
}
    </tbody>
</table>
