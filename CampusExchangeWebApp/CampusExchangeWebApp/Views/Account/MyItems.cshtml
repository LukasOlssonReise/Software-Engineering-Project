@model IEnumerable<CampusExchangeWebApp.Models.ProductModel>

@{
    ViewData["Title"] = "My Items Page";
}

<h1>List of my Items</h1>

<p>
    <a asp-controller="Product" asp-action="Create">Offer an Item</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Photo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Category)
            </td>
            <td>
                <img src="@item.Photo" width="125" height="125"/>
            </td>
            <td>
                <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
