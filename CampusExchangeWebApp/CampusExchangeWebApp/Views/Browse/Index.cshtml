@{
    ViewData["Title"] = "Browse Page";
}

<h4>Browse Page</h4>
<hr />

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card h-100">
            <img src="https://images.pexels.com/photos/6952419/pexels-photo-6952419.jpeg" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">Pencils</h5>
                <p class="card-text">Vibrant close-up of sharpened colored pencils against a beige background, ideal for creative concepts.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <img src="https://images.pexels.com/photos/6567865/pexels-photo-6567865.jpeg" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">Papers</h5>
                <p class="card-text">Close-up of hands holding a stack of colored and white papers in an office setting.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <img src="https://images.pexels.com/photos/6193753/pexels-photo-6193753.jpeg" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">Eraser</h5>
                <p class="card-text">Close-up of a mint green eraser with 'I love mistakes' on a pink background.</p>
            </div>
        </div>
    </div>
</div>