@model IEnumerable<CampusExchangeWebApp.Models.ProductModel>

@{
    ViewData["Title"] = "Browse Page";
}

<h1>List of all Items</h1>
<hr />

<div class="container d-flex flex-wrap">

    @foreach(var item in Model)
    {
        <div class="card mb-3" style="width: 18rem;">
            <img src="@item.Photo" class="card-img-top" alt="@item.Photo">
            <div class="card-body">
                <span class="badge bg-primary">@item.Category</span>
                <h5 class="card-title">@item.Name</h5>
                <p class="card-text">@item.Description</p>

                @if (User.Identity.IsAuthenticated)
                {
                    <a href="/Request/Borrow/@item.Id" class="btn btn-primary">Request to borrow</a>
                }
                else
                {
                    <p>
                        <a asp-controller="Account" asp-action="Login">Log in</a> to borrow this item.
                    </p>
                }
                
                <a href="/Browse/Details/@item.Id" class="btn btn-info">Show Details</a>
            </div>
        </div>
    }

</div>