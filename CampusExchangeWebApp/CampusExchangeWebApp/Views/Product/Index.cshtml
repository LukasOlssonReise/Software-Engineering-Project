@model IEnumerable<CampusExchangeWebApp.Models.ProductModel>

@{
    ViewData["Title"] = "Browse Page";
}

<p>
    <a asp-action="Create">Create New</a>
</p>

<div class="container d-flex flex-wrap">

    @foreach(var item in Model)
    {
        <div class="card mb-3" style="width: 18rem;">
            <svg xmlns="http://www.w3.org/2000/svg" class="d-block user-select-none" width="100%" height="200" aria-label="Placeholder: Image cap" focusable="false" role="img" preserveAspectRatio="xMidYMid slice" viewBox="0 0 318 180" style="font-size:1.125rem;text-anchor:middle">
                <rect width="100%" height="100%" fill="#868e96"></rect>
                <text x="50%" y="50%" fill="#dee2e6" dy=".3em">Image cap</text>
            </svg>
            <div class="card-body">
                <h5 class="card-title">@item.Name</h5>
                <p class="card-text">@item.Description</p>
                <a href="/Product/Details/@item.Id" class="btn btn-info">Details</a>
                <a href="/Product/Edit/@item.Id" class="btn btn-warning">Edit</a>
                <a href="/Product/Delete/@item.Id" class="btn btn-danger">Delete</a>
            </div>
        </div>
    }

</div>