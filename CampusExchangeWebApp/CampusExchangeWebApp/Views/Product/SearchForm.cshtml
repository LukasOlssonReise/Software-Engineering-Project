@model CampusExchangeWebApp.Models.ProductModel

@{
    ViewData["Title"] = "Search Form";
}

<h4>Search Form</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="SearchResults">

            <div class="form-group mb-3">
                <label class="control-label">Search for a Product Name</label>
                <input name="searchTerm" class="form-control" />
            </div>

            <div class="form-group">
                <input type="submit" value="Search" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
