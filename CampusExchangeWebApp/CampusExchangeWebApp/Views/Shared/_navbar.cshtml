<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="light">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Campus Exchange</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarColor01">

            <!-- Left side of the navbar -->
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Browse" asp-action="Index">Browse</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Browse" asp-action="Search">Search</a>
                </li>
            </ul>

            <!-- Right side of the navbar -->
            <ul class="navbar-nav ms-auto">

                <!-- Shows this if the user is currently logged in to an account -->
                @if (User.Identity.IsAuthenticated)
                {
                    // Welcome message
                    <li class="nav-item">
                        <span class="nav-link text-dark">Hello, @User.Identity.Name!</span>
                    </li>

                    // Requests
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Request" asp-action="MyRequests">My Requests</a>
                    </li>

                    // My Items
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="MyItems">My Items</a>
                    </li>

                    // Account is only visible to administrators
                    @if (User.IsInRole("Admin"))
                    {
                        <!-- Requests -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Request" asp-action="Index">Requests</a>
                        </li>
                        <!-- Product -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                        </li>
                        <!-- Account -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Index">Accounts</a>
                        </li>
                    }

                    // Logout
                    <li class="nav-item">
                        <a class="btn btn-danger" asp-area="" asp-controller="Account" asp-action="Logout">Logout</a>
                    </li>
                }
                
                // Shows this if the user is not logged in to an account
                else
                {
                    // Login
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                    </li>

                    // Create an Account
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Create">Create an Account</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
